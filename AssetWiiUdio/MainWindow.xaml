<Window x:Class="AssetWiiUdio.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="AssetWiiUdio v0.5.7 · Wii U Archive &amp; Asset Explorer" Width="1450" Height="820" WindowState="Normal" WindowStartupLocation="CenterScreen" MinWidth="850" MinHeight="550" Background="#161B24" Foreground="#E8EDF6"><Window.Resources><Style TargetType="Button"><Setter Property="Margin" Value="3"/><Setter Property="Padding" Value="12,7"/><Setter Property="Background" Value="#34465D"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/></Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8EDF6"/></Style></Window.Resources><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Vertical" Background="#222C3B"><Menu Background="#26364B" Foreground="#E8EDF6"><MenuItem Header="⚙ Settings" Foreground="#E8EDF6"><MenuItem Header="Configure Common Key…" Click="ConfigureCommonKey_Click"/><MenuItem Header="Import Names…" Click="ImportNames_Click"/><Separator/><MenuItem Header="Diagnostics"><MenuItem Header="Check NUS Package Files" Click="CheckPackage_Click"/><MenuItem Header="Selected File Diagnostics" Click="FileDiagnostics_Click"/><Separator/><MenuItem Header="FST Diagnostics" Click="Diagnostics_Click"/><MenuItem Header="Hashed Content Diagnostics" Click="HashedDiagnostics_Click"/></MenuItem></MenuItem></Menu><StackPanel Orientation="Horizontal"><Button Click="Open_Click">📂 Open NUS Folder</Button><Button Click="ShowPackage_Click">📦 Package View</Button><Button Click="ShowFilesystem_Click">📁 Filesystem View</Button><Button Click="OpenVirtual_Click">🗂 Open Virtual Filesystem</Button><Button Click="Inspector_Click">🔎 Metadata Inspector</Button><Button Click="AssetInspector_Click">🧬 Asset Inspector</Button><Button Click="ArchiveBrowser_Click">🗃 Archive Browser</Button><Button Click="ExtractRaw_Click">⬇ Export Selected Files</Button><Button Click="ExtractAll_Click">📦 Decrypt Game (CDecrypt)</Button><Button Click="OpenExtracted_Click">📁 Open Extracted Folder</Button><Button Click="About_Click">ℹ About</Button></StackPanel></StackPanel><Border DockPanel.Dock="Bottom" Background="#26364B" Padding="10,7"><TextBlock x:Name="Status" Text="Ready · Open a Wii U NUS directory"/></Border><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="5"/><ColumnDefinition Width="*"/><ColumnDefinition Width="5"/><ColumnDefinition Width="350"/></Grid.ColumnDefinitions><Border Grid.Column="0" Background="#1D2633" Padding="10"><DockPanel><TextBlock DockPanel.Dock="Top" FontSize="16" FontWeight="Bold" Margin="0,0,0,12">EXPLORER</TextBlock><TextBox DockPanel.Dock="Top" x:Name="TreeSearchBox" Margin="0,0,0,5" Padding="6" Background="#293749" Foreground="White" BorderBrush="#536579" ToolTip="Search all virtual files by hash, filename, or mapped name" TextChanged="TreeSearchBox_TextChanged"/>
<TextBlock DockPanel.Dock="Top" x:Name="TreeSearchCount" Text="Search the full virtual filesystem" FontSize="11" Margin="0,0,0,6" TextWrapping="Wrap"/>
<ListBox DockPanel.Dock="Top" x:Name="TreeSearchResults" Height="205" Visibility="Collapsed" Background="#182231" Foreground="White" BorderBrush="#536579" SelectionChanged="TreeSearchResults_SelectionChanged" DisplayMemberPath="Display"/>
<TreeView x:Name="FolderTree" Background="#1D2633" Foreground="White" BorderThickness="0" SelectedItemChanged="FolderTree_SelectedItemChanged"/></DockPanel></Border><GridSplitter Grid.Column="1" Width="5" Background="#34465D" HorizontalAlignment="Stretch"/><DockPanel Grid.Column="2" Margin="8"><TextBlock DockPanel.Dock="Top" Text="FILES" FontWeight="Bold" FontSize="16" Margin="4,0,0,10"/><TextBox DockPanel.Dock="Top" x:Name="FilterBox" TextChanged="FilterBox_TextChanged" Margin="0,0,0,8" Padding="7" Background="#293749" Foreground="White" BorderBrush="#536579" ToolTip="Filter current folder by filename"/><ListView x:Name="FilesList" SelectionMode="Extended" SelectionChanged="FilesList_SelectionChanged" Background="#1D2633" Foreground="White" BorderThickness="0"><ListView.View><GridView><GridViewColumn Header="Name" Width="260" DisplayMemberBinding="{Binding Name}"/><GridViewColumn Header="Size" Width="95" DisplayMemberBinding="{Binding DisplaySize}"/><GridViewColumn Header="Type" Width="90" DisplayMemberBinding="{Binding Extension}"/></GridView></ListView.View></ListView></DockPanel><GridSplitter Grid.Column="3" Width="5" Background="#34465D" HorizontalAlignment="Stretch"/><DockPanel Grid.Column="4" Margin="10"><TextBlock DockPanel.Dock="Top" Text="PREVIEW" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/><TextBlock DockPanel.Dock="Top" x:Name="PreviewTitle" TextWrapping="Wrap" Margin="0,0,0,10"/><TextBox x:Name="PreviewText" Background="#111923" Foreground="#A8E1E6" BorderThickness="0" FontFamily="Consolas" FontSize="12" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"/></DockPanel></Grid></DockPanel></Window>